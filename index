<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ลอยกระทงออนไลน์ ๒๕๖๙</title>
<meta name="color-scheme" content="dark">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Chonburi&family=Sarabun:wght@300;400;600&display=swap" rel="stylesheet">
<style>
:root{--ink:#0b1130;--night:#141c4a;--panel:#1a2358;--gold:#d9b25f;--gold2:#f3de9b;--cream:#f6ecd2;--ruby:#a8323e;--ra:#10204a;--rb:#1d3a73;
color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--ink);color:var(--cream);font:400 17px/1.75 "Sarabun",sans-serif;
background-image:radial-gradient(circle at 20% 0,#26327a55,transparent 50%),radial-gradient(circle at 90% 30%,#a8323e22,transparent 40%)}
h1,h2,h3{font-family:"Chonburi","Sarabun",serif;font-weight:400;margin:0;color:var(--gold2);line-height:1.4}
.wrap{max-width:980px;margin:0 auto;padding:0 16px}
.frame{border:1px solid var(--gold);outline:1px solid var(--gold);outline-offset:4px;border-radius:6px;background:var(--panel)}
header{text-align:center;padding:28px 0 18px}
.college{color:var(--gold);font-size:15px;letter-spacing:.04em}
h1{font-size:clamp(34px,8vw,64px);text-shadow:0 2px 0 #6b4b12,0 0 24px #d9b25f55}
.orn{color:var(--gold);letter-spacing:.6em;margin:2px 0}
.sub{max-width:34em;margin:6px auto 0;font-weight:300}
#scene{position:relative;overflow:hidden;margin:14px 0 8px;min-height:540px;
background:radial-gradient(circle at 78% 18%,#fff6d6 0 22px,#f3de9b33 23px 60px,transparent 62px),linear-gradient(#0b1130,#1a2358 40%,var(--ra) 41%,var(--rb))}
#scene::before{content:"";position:absolute;inset:0 0 auto;height:42%;
background-image:radial-gradient(1.5px 1.5px at 12% 20%,#fff,transparent),radial-gradient(1.5px 1.5px at 33% 40%,#fff,transparent),radial-gradient(1.5px 1.5px at 55% 15%,#fff,transparent),radial-gradient(1px 1px at 68% 45%,#fff,transparent),radial-gradient(1.5px 1.5px at 90% 33%,#fff,transparent),radial-gradient(1px 1px at 5% 50%,#fff,transparent)}
.bank{position:absolute;left:2%;right:2%;top:calc(42% - 62px);z-index:1;display:flex;justify-content:space-around;align-items:flex-end;pointer-events:none}
.st{width:clamp(54px,12vw,96px);text-align:center;font-size:24px;line-height:1.2}
.st i{display:block;height:12px;border-radius:6px 6px 0 0;background:repeating-linear-gradient(90deg,#a8323e 0 10px,#f6ecd2 10px 20px);box-shadow:0 2px 0 #6b4b12}
.st div{background:#241a3a;border:1px solid var(--gold);border-top:0;padding:2px 0;box-shadow:0 0 14px #ffb43a55 inset}
.st small{display:block;font:300 11px/1.2 "Sarabun";color:var(--gold2)}
#river{position:absolute;left:0;right:0;top:42%;bottom:0;background:repeating-linear-gradient(180deg,transparent 0 22px,#ffffff0d 22px 24px)}
.hud{position:absolute;left:12px;right:12px;top:10px;display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;z-index:3}
.count{background:#0b1130cc;border:1px solid var(--gold);border-radius:4px;padding:2px 14px;font-family:"Chonburi";color:var(--gold2)}
.count b{font-size:24px;color:#fff}
.tabs{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
button,select,input,textarea{font:inherit}
.btn{background:#0b1130cc;color:var(--cream);border:1px solid var(--gold);border-radius:4px;padding:2px 12px;cursor:pointer}
.btn[aria-pressed=true]{background:var(--gold);color:var(--ink)}
.btn:focus-visible,.kr:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--gold2);outline-offset:2px}
.kr{position:absolute;width:64px;background:none;border:0;padding:0;cursor:pointer;color:var(--cream);animation:bob var(--d) ease-in-out infinite alternate}
.kr svg{width:64px;height:64px;display:block;filter:drop-shadow(0 4px 6px #0008)}
.kr span{display:block;position:absolute;left:50%;top:62px;transform:translateX(-50%);white-space:nowrap;font-size:12px;line-height:1.3;background:#0b1130bb;padding:0 6px;border-radius:3px;max-width:110px;overflow:hidden;text-overflow:ellipsis}
@keyframes bob{from{transform:translate(calc(var(--w)*-1),0)}to{transform:translate(var(--w),4px)}}
.empty{position:absolute;inset:55% 0 auto;text-align:center;color:var(--gold2);font-weight:300}
section{margin:34px 0}
section>h2{font-size:clamp(22px,4vw,30px);margin-bottom:12px;text-align:center}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;padding:22px}
@media(max-width:720px){.grid{grid-template-columns:1fr;padding:16px}}
label{display:block;font-weight:600;color:var(--gold2);margin:12px 0 2px}
input[type=text],textarea,select{width:100%;background:var(--ink);color:var(--cream);border:1px solid #d9b25f88;border-radius:4px;padding:6px 10px}
.opts{display:flex;gap:8px;flex-wrap:wrap}
.opt{border:1px solid #d9b25f88;border-radius:4px;background:var(--ink);color:var(--cream);padding:4px 12px;cursor:pointer}
.opt[aria-pressed=true]{background:var(--gold);color:var(--ink);border-color:var(--gold2)}
.opt.ch{font-size:26px;padding:0 8px;line-height:1.5}
.preview{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;background:radial-gradient(circle,var(--rb),var(--ra));border-radius:6px;min-height:260px;padding:14px}
.preview svg{width:170px;height:170px}
.go{width:100%;margin-top:16px;background:linear-gradient(var(--gold2),var(--gold));color:var(--ink);font:400 20px "Chonburi";border:0;border-radius:4px;padding:8px;cursor:pointer;box-shadow:0 3px 0 #6b4b12}
.go:disabled{opacity:.5}
.msg{min-height:1.6em;color:var(--gold2);text-align:center}
#list{list-style:none;margin:0;padding:8px 22px;max-height:420px;overflow:auto}
#list li{display:flex;gap:12px;align-items:center;padding:8px 0;border-bottom:1px dashed #d9b25f55}
#list .av{font-size:26px}#list .t{margin-left:auto;font-size:13px;color:#d9b25f;white-space:nowrap}
#list small{display:block;font-weight:300;line-height:1.3}
dialog{background:var(--panel);color:var(--cream);border:1px solid var(--gold);outline:1px solid var(--gold);outline-offset:4px;border-radius:6px;max-width:380px;width:calc(100% - 40px);text-align:center}
dialog::backdrop{background:#000a}
dialog svg{width:120px;height:120px}dialog img{width:96px;height:96px;object-fit:cover;border-radius:50%;border:2px solid var(--gold)}
footer{text-align:center;color:#d9b25faa;font-size:14px;padding:10px 0 30px}
.skyline{position:absolute;left:0;top:calc(42% - 118px);width:100%;height:120px}
.skyline .w{animation:tw 2.4s ease-in-out infinite alternate}@keyframes tw{from{opacity:.5}to{opacity:1}}
.wheel{position:absolute;left:4%;top:calc(42% - 160px);width:118px;opacity:.95}
.spin{transform-origin:50px 50px;animation:spin 50s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.lant{position:absolute;left:0;right:0;top:78px;display:flex;justify-content:space-around;font-size:22px;pointer-events:none}
.lant span{display:block;transform-origin:top;animation:sw 3s ease-in-out infinite alternate;filter:drop-shadow(0 0 8px #ffb43a)}
.lant span:nth-child(even){animation-delay:-1.5s}@keyframes sw{from{transform:rotate(-7deg)}to{transform:rotate(7deg)}}
#river{animation:rip 3s linear infinite}@keyframes rip{to{background-position:0 24px}}
#fw{position:absolute;inset:0;width:100%;height:100%;z-index:2;pointer-events:none}
#trk{width:auto;background:#0b1130cc;color:var(--cream);border:1px solid var(--gold);padding:2px 8px;border-radius:4px}
#wp .opt{font-size:14px;padding:0 10px;line-height:1.7}
#bg{position:absolute;inset:0;width:100%;height:100%;z-index:0}
#scene::before{display:none}
#river{background:none}
.skyline{filter:drop-shadow(0 -4px 14px #ffb43a44)}
#lan{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:1}
.opt.ch svg{width:30px;height:54px;display:block}
#list .av svg{width:22px;height:40px;vertical-align:middle}
dialog .pv svg{width:56px;height:100px}
.kg{position:absolute;width:56px;left:var(--l);pointer-events:none;opacity:.92;animation:flow var(--v) linear infinite,bob2 3s ease-in-out infinite alternate}
.kg svg{width:56px;height:56px;display:block;filter:drop-shadow(0 4px 5px #0008)}
@keyframes flow{from{left:-70px}to{left:100%}}@keyframes bob2{from{transform:translateY(0)}to{transform:translateY(5px)}}
.kg.ln{animation:launch 9s ease-out forwards}
@keyframes launch{0%{transform:translate(-50%,0) scale(1);opacity:0}10%{opacity:1}100%{transform:translate(20px,-150px) scale(.55);opacity:0}}
#crowd{position:absolute;left:0;right:0;bottom:0;height:120px;pointer-events:none;z-index:1}
#crowd::before{content:'';position:absolute;left:0;right:0;bottom:0;height:34px;background:linear-gradient(transparent,#04060fd9 75%)}
.pp{position:absolute;width:42px;height:72px;transform:translateX(-50%) scale(var(--sc));transform-origin:bottom center;pointer-events:none;background:none;border:0;padding:0;color:var(--cream)}
.pp.real{pointer-events:auto;cursor:pointer}
.pi{position:relative;transform-origin:bottom center;animation:lean 4s ease-in-out infinite alternate;animation-delay:var(--dl)}
.pi svg{width:42px;height:72px;display:block}
@keyframes lean{from{transform:rotate(-2deg)}to{transform:rotate(2deg)}}
.hk{position:absolute;left:8px;top:40px;width:26px}.hk svg{width:26px;height:26px;filter:drop-shadow(0 0 5px #ffb43a99)}
.pn{position:absolute;bottom:100%;left:50%;transform:translateX(-50%);white-space:nowrap;font-size:11px;line-height:1.3;background:#0b1130cc;padding:0 6px;border-radius:3px;max-width:100px;overflow:hidden;text-overflow:ellipsis;margin-bottom:2px}
.rd{position:absolute;top:calc(42% - 164px);filter:drop-shadow(0 0 10px #ffb43a77);pointer-events:none}
.carou{left:17%;width:112px}.viking{left:36%;width:120px}.stage{right:2%;width:clamp(150px,22%,212px);top:calc(42% - 168px)}
.rd .bk{animation:bk 1s steps(1) infinite}.rd .bk2{animation:bk 1s steps(1) infinite .5s}@keyframes bk{0%{opacity:1}50%{opacity:.2}}
.rd .hs{animation:hs 1.6s ease-in-out infinite alternate}.rd .hs2{animation-delay:-.8s}@keyframes hs{to{transform:translateY(-6px)}}
.rd .sw{transform-origin:55px 14px;animation:swg 3.2s ease-in-out infinite alternate}@keyframes swg{from{transform:rotate(-38deg)}to{transform:rotate(38deg)}}
.rd .bm{transform-origin:110px 14px;animation:bm 3s ease-in-out infinite alternate}@keyframes bm{from{transform:rotate(-14deg)}to{transform:rotate(14deg)}}
.rd .dn{animation:dn .55s ease-in-out infinite alternate}.rd .dn2{animation-delay:-.27s}@keyframes dn{to{transform:translateY(-4px)}}
.kh{position:absolute;top:80%;width:46px;background:none;border:0;padding:0;cursor:pointer;pointer-events:auto;color:var(--cream);filter:drop-shadow(0 0 14px #ffb43a);animation:rise var(--d) linear infinite,sway 5s ease-in-out infinite alternate}
.kh svg{width:46px;height:69px;display:block}
.kh span{position:absolute;left:50%;top:68px;transform:translateX(-50%);white-space:nowrap;font-size:12px;line-height:1.3;background:#0b1130bb;padding:0 6px;border-radius:3px;max-width:110px;overflow:hidden;text-overflow:ellipsis}
@keyframes rise{0%{transform:translateY(0);opacity:0}8%{opacity:1}85%{opacity:1}100%{transform:translateY(-560px);opacity:0}}
@keyframes sway{from{margin-left:-12px}to{margin-left:12px}}
@media(max-width:560px){#scene{min-height:600px}.wheel,.carou,.viking{display:none}.stage{width:150px;top:calc(42% - 125px)}.st small{font-size:10px}}
@media(prefers-reduced-motion:reduce){.kr,.lant span,.spin,#river,.skyline .w{animation:none}.kh{animation:none;top:25%}.rd *,.pi,.kg{animation:none}}
</style>
</head>
