l='#ffd34d'/></g><rect x='0' y='56' width='14' height='48' fill='#15101f' stroke='#d9b25f' stroke-opacity='.4'/><rect x='206' y='56' width='14' height='48' fill='#15101f' stroke='#d9b25f' stroke-opacity='.4'/><circle cx='7' cy='70' r='4' fill='#3a3050'/><circle cx='213' cy='70' r='4' fill='#3a3050'/><path d='M14 26V94M206 26V94' stroke='#d9b25f' stroke-opacity='.5' stroke-width='2'/><g fill='#05060f'><circle cx='20' cy='110' r='6'/><circle cx='42' cy='108' r='6'/><circle cx='66' cy='111' r='6'/><circle cx='90' cy='108' r='6'/><circle cx='116' cy='110' r='6'/><circle cx='140' cy='108' r='6'/><circle cx='166' cy='111' r='6'/><circle cx='192' cy='109' r='6'/><rect x='0' y='116' width='220' height='14'/></g></svg>
  <div class="lant" aria-hidden="true"><span>🏮</span><span>🏮</span><span>🏮</span><span>🏮</span><span>🏮</span><span>🏮</span><span>🏮</span></div>
  <div class="bank" aria-hidden="true"><div class="st"><i></i><div>🍡<small>ขนมไทย</small></div></div><div class="st"><i></i><div>🏮<small>โคมไฟ</small></div></div><div class="st"><i></i><div>🪷<small>ร้านกระทง</small></div></div><div class="st"><i></i><div>🍢<small>ปิ้งย่าง</small></div></div><div class="st"><i></i><div>🎠<small>ม้าหมุน</small></div></div></div>
  <div id="crowd"></div>
  <div id="lan"></div>
