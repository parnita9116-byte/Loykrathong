<script>
const CFG={college:"วิทยาลัยเทคนิคท่าหลวงซิเมนต์ไทยอนุสรณ์",year:"๒๕๖๙"};
const BASES={lotus:{n:"ดอกบัวชมพู",c:"#e8a1b0",c2:"#b5546e",s:"petal"},white:{n:"บัวขาว",c:"#f7f1e6",c2:"#a89f8c",s:"petal"},ruby:{n:"บัวทับทิม",c:"#d6455a",c2:"#7a1f2f",s:"petal"},banana:{n:"ใบตอง",c:"#7fa650",c2:"#4d6e2d"},gold:{n:"ทองคำ",c:"#e5c26a",c2:"#a67c1d"},coconut:{n:"กะลามะพร้าว",c:"#9a6a3a",c2:"#5a3a1c",s:"bowl"},bread:{n:"ขนมปัง",c:"#f0d9a0",c2:"#b88a3a",s:"bread"}};
const RIVERS={old:{n:"สายน้ำโบราณ",a:"#10204a",b:"#1d3a73"},ruby:{n:"สายน้ำชาด",a:"#2a0f1d",b:"#5a1f3a"},jade:{n:"สายน้ำหยก",a:"#0b2a2a",b:"#145252"}};
const TOPS={flower:"ดอกไม้",garland:"พวงมาลัย",ribbon:"ริบบิ้น",incense:"ธูป",candle:"เทียน"};
const CHARS=["🧑‍🎓","👩‍🎓","🧑‍🔧","👩‍🔧","🧑‍🍳","🧑‍💻"];
const $=s=>document.querySelector(s);
const PEOPLE={c1:{n:'หญิงชุดไทย',sk:'#f0c8a0',hr:'#1a1010',top:'#e8789a',bot:'#c9a227',skirt:1,bun:1},c2:{n:'ชายราชปะแตน',sk:'#e8b98a',hr:'#15100c',top:'#f6efe0',bot:'#2a4aa0',sash:'#c9a227'},c3:{n:'นักศึกษาหญิง',sk:'#f0c8a0',hr:'#1a1010',top:'#ffffff',bot:'#1d2236',skirt:1},c4:{n:'นักศึกษาชาย',sk:'#e8b98a',hr:'#15100c',top:'#ffffff',bot:'#1d2236'},c5:{n:'ช่างหญิง',sk:'#f0c8a0',hr:'#1a1010',top:'#2f4e8c',bot:'#2f4e8c',cap:'#f3d12a'},c6:{n:'ช่างชาย',sk:'#e0ac7c',hr:'#15100c',top:'#c8512a',bot:'#2f4e8c',cap:'#f3d12a'}};
function pSVG(id){const p=PEOPLE[id]||PEOPLE.c1;return `<svg viewBox='0 0 40 72' aria-hidden='true'><ellipse cx='20' cy='69' rx='11' ry='2.5' fill='#0006'/>${p.skirt?`<path d='M10 40H30L34 68H6Z' fill='${p.bot}'/>`:`<path d='M12 40H28L27 68H21V50H19V68H13Z' fill='${p.bot}'/>`}<path d='M11 22Q20 18 29 22L31 42H9Z' fill='${p.top}'/>${p.sash?`<path d='M11 24L30 40V44L9 28Z' fill='${p.sash}'/>`:''}${id==='c1'?`<path d='M12 22Q20 30 30 20L32 28Q20 38 10 30Z' fill='#c9a227'/>`:''}<path d='M11 26L7 40M29 26L33 40' stroke='${p.sk}' stroke-width='4' stroke-linecap='round'/><circle cx='20' cy='12' r='8' fill='${p.sk}'/><path d='M11 11Q12 2 20 2Q28 2 29 11Q24 6 20 6Q15 6 11 11Z' fill='${p.hr}'/>${p.bun?`<circle cx='20' cy='2.5' r='4' fill='${p.hr}'/><circle cx='20' cy='2' r='1.4' fill='#e5c26a'/>`:''}${p.cap?`<path d='M11 9Q20 -2 29 9Z' fill='${p.cap}'/>`:''}<circle cx='17' cy='13' r='.9' fill='#222'/><circle cx='23' cy='13' r='.9' fill='#222'/><path d='M17.5 16.5Q20 18 22.5 16.5' stroke='#a33' fill='none' stroke-width='.8'/></svg>`}
const sel={base:"lotus",top:{flower:true,incense:true,candle:true},ch:"c1",img:"",kind:"krathong",lc:"gold"};CHARS.splice(0,CHARS.length,"c1","c2","c3","c4","c5","c6");
let items=[],col=null;
$("#college").textContent=CFG.college+" · งานลอยกระทง "+CFG.year;
$("#ft").textContent="กิจกรรมลอยกระทงออนไลน์ "+CFG.college+" ปี "+CFG.year;

function kSVG(k){const b=BASES[k.base]||BASES.lotus,t=k.top||{};
let s=`<svg viewBox="0 0 100 100" aria-hidden="true"><ellipse cx="50" cy="86" rx="42" ry="8" fill="${b.c2}"/>`;
const sh=b.s||"leaf";
if(sh==="petal")for(let i=0;i<7;i++){const x=16+i*11.3;s+=`<ellipse cx="${x}" cy="74" rx="8" ry="15" fill="${b.c}" stroke="${b.c2}" transform="rotate(${(i-3)*16} ${x} 86)"/>`}
else if(sh==="bowl")s+=`<path d="M10 66H90Q84 92 50 92Q16 92 10 66Z" fill="${b.c}" stroke="${b.c2}" stroke-width="1.5"/><path d="M10 66H90" stroke="${b.c2}" stroke-width="3"/>`;
else if(sh==="bread")s+=`<ellipse cx="50" cy="76" rx="40" ry="12" fill="${b.c}" stroke="${b.c2}"/><ellipse cx="50" cy="68" rx="32" ry="9" fill="${b.c}" stroke="${b.c2}"/>`;
else s+=`<path d="M8 74 Q50 44 92 74 L84 86 Q50 70 16 86Z" fill="${b.c}" stroke="${b.c2}" stroke-width="1.5"/>`;
if(t.flower)s+=`<circle cx="30" cy="66" r="6" fill="#f08a24"/><circle cx="70" cy="66" r="6" fill="#f5a623"/><circle cx="50" cy="62" r="7" fill="#f08a24"/>`;
if(t.garland)for(let i=0;i<7;i++)s+=`<circle cx="${18+i*11}" cy="${80+(i%2)*3}" r="4" fill="${i%2?'#fff3d6':'#ffd34d'}" stroke="#a67c1d" stroke-width=".6"/>`;
if(t.ribbon)s+=`<path d="M50 66L36 56L38 72ZM50 66L64 56L62 72Z" fill="#c8323e"/><path d="M50 66L44 84M50 66L56 84" stroke="#c8323e" stroke-width="3"/>`;
if(t.incense)s+=`<path d="M42 62V24M58 62V28" stroke="#8a5a30" stroke-width="2"/><circle cx="42" cy="23" r="1.8" fill="#ff6b3d"/><circle cx="58" cy="27" r="1.8" fill="#ff6b3d"/>`;
if(t.candle)s+=`<rect x="47" y="42" width="6" height="22" fill="#fff3d6"/><path d="M50 31c4 5 3 10 0 11-3-1-4-6 0-11z" fill="#ffb43a"><animate attributeName="opacity" values="1;.55;1" dur="1.1s" repeatCount="indefinite"/></path>`;
return s+"</svg>"}

function hash(s){let h=0;for(const c of String(s))h=(h*31+c.charCodeAt(0))|0;return Math.abs(h)}
function ago(t){const m=Math.max(0,Math.round((Date.now()-t)/60000));return m<1?"เมื่อครู่":m<60?m+" นาทีที่แล้ว":m<1440?Math.round(m/60)+" ชม. ที่แล้ว":new Date(t).toLocaleDateString("th-TH")}

function renderAll(){
 const r=$("#river");r.querySelectorAll(".kr").forEach(e=>e.remove());
 items.filter(k=>k.kind!=="lantern").slice(0,60).forEach(k=>{const h=hash(k.id),b=document.createElement("button");
  b.className="kr";b.style.cssText=`left:${3+h%82}%;top:${(h>>3)%4*17}%;zoom:${(.7+(h>>3)%4*.1).toFixed(2)};--d:${5+h%5}s;--w:${10+h%14}px`;
  b.innerHTML=kSVG(k)+"<span></span>";b.querySelector("span").textContent=k.name;b.setAttribute("aria-label","กระทงของ "+k.name);
  b.onclick=()=>show(k);r.appendChild(b)});
 renderLanterns();renderCrowd();$("#cnt").textContent=items.length>=200?"200+":items.length;
 $("#empty").style.display=items.length?"none":"block";
 const ul=$("#list");ul.replaceChildren();
 items.slice(0,100).forEach(k=>{const li=document.createElement("li");
  const av=document.createElement("span");av.className="av";av.textContent=(k.kind==="lantern"?"🏮":"🪷")+(PEOPLE[k.ch]?"":k.ch||"");
  const d=document.createElement("div");d.textContent=k.name;
  if(k.dept){const sm=document.createElement("small");sm.textContent="แผนก"+k.dept;d.appendChild(sm)}
  const t=document.createElement("span");t.className="t";t.textContent=ago(k.t);
  if(PEOPLE[k.ch])av.insertAdjacentHTML("beforeend",pSVG(k.ch));li.append(av,d,t);li.style.cursor="pointer";li.onclick=()=>show(k);ul.appendChild(li)});
 if(!items.length){const li=document.createElement("li");li.textContent="ยังไม่มีผู้ลอยกระทง";ul.appendChild(li)}
}

function show(k){const c=$("#dc");c.replaceChildren();
 const sv=document.createElement("div");sv.innerHTML=(k.kind==="lantern"?lSVG(k.lc):kSVG(k))+(PEOPLE[k.ch]?`<div class='pv'>${pSVG(k.ch)}</div>`:"");c.appendChild(sv);
 if(k.img&&/^data:image\//.test(k.img)){const i=document.createElement("img");i.src=k.img;i.alt="";c.appendChild(i)}
 const h=document.createElement("h3");h.textContent=(PEOPLE[k.ch]?"":k.ch||"")+" "+k.name;c.appendChild(h);
 if(k.dept){const p=document.createElement("div");p.textContent="แผนก"+k.dept;c.appendChild(p)}
 const w=document.createElement("p");w.textContent=k.wish?"“"+k.wish+"”":"ขอให้ทุกสิ่งที่หวังเป็นจริง";c.appendChild(w);
 $("#dlg").showModal()}

function pv(){$("#pv").innerHTML=sel.kind==="lantern"?lSVG(sel.lc):kSVG(sel);$("#pvn").textContent=($("#nm").value||"ชื่อของคุณ")}
function toggles(id,obj,key,cur,multi){const box=$(id);box.replaceChildren();
 Object.keys(obj).forEach(k=>{const b=document.createElement("button");b.type="button";b.className="opt";b.textContent=obj[k].n||obj[k];
  const on=()=>multi?!!sel.top[k]:sel.base===k;b.setAttribute("aria-pressed",on());
  b.onclick=()=>{if(multi)sel.top[k]=!sel.top[k];else sel.base=k;toggles(id,obj,key,cur,multi);pv()};box.appendChild(b)})}
function chars(){const box=$("#chars");box.replaceChildren();CHARS.forEach(c=>{const b=document.createElement("button");b.type="button";b.className="opt ch";b.innerHTML=pSVG(c);b.setAttribute("aria-label","ตัวละคร "+c);b.setAttribute("aria-pressed",sel.ch===c);b.onclick=()=>{sel.ch=c;chars()};box.appendChild(b)})}
toggles("#bases",BASES,"base");toggles("#tops",TOPS,"top",null,true);chars();pv();
$("#nm").addEventListener("input",pv);

$("#im").onchange=e=>{const f=e.target.files[0];if(!f){sel.img="";return}
 const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const c=document.createElement("canvas");c.width=c.height=96;const x=c.getContext("2d");const s=Math.min(im.width,im.height);x.drawImage(im,(im.width-s)/2,(im.height-s)/2,s,s,0,0,96,96);sel.img=c.toDataURL("image/jpeg",.6)};im.src=r.result};r.readAsDataURL(f)};

function setRiver(k){const r=RIVERS[k];const s=$("#scene").style;s.setProperty("--ra",r.a);s.setProperty("--rb",r.b);
 document.querySelectorAll("#rtabs .btn").forEach(b=>b.setAttribute("aria-pressed",b.dataset.k===k));try{localStorage.setItem("river",k)}catch(e){}window.bgReady&&buildBG()}
Object.keys(RIVERS).forEach(k=>{const b=document.createElement("button");b.className="btn";b.dataset.k=k;b.textContent=RIVERS[k].n;b.onclick=()=>setRiver(k);$("#rtabs").appendChild(b)});
let sv="old";try{sv=localStorage.getItem("river")||"old"}catch(e){}setRiver(RIVERS[sv]?sv:"old");

$("#f").onsubmit=async e=>{e.preventDefault();
 const name=$("#nm").value.trim();if(!name)return;
 const t=Date.now(),k={name,dept:$("#dp").value.trim(),wish:$("#ws").value.trim(),base:sel.base,top:{...sel.top},ch:sel.ch,img:sel.img,kind:sel.kind,lc:sel.lc,t};
 const id="k"+t+Math.random().toString(36).slice(2,6);$("#go").disabled=true;
 try{if(col)await col.doc(id).set(k);else{items.unshift({id,...k});renderAll()}
  $("#fm").textContent=(k.kind==="lantern"?"โคมลอยของ "+name+" ลอยขึ้นสู่ท้องฟ้าแล้ว":"กระทงของ "+name+" ลอยลงสายน้ำแล้ว")+" ขอให้สมปรารถนา";
  $("#f").reset();sel.img="";pv();window.scrollTo({top:0,behavior:"smooth"});fireworks(5);if(!RM)launch()}
 catch(err){$("#fm").textContent="ลอยไม่สำเร็จ ลองอีกครั้ง"}
 $("#go").disabled=false};

let ac,tm;
$("#mus").onclick=function(){const on=this.getAttribute("aria-pressed")!=="true";this.setAttribute("aria-pressed",on);
 if(!on){clearInterval(tm);return}
 ac=ac||new (window.AudioContext||window.webkitAudioContext)();ac.resume();
 const N=[262,294,330,392,440,523,587,659];let i=0;
 tm=setInterval(()=>{const o=ac.createOscillator(),g=ac.createGain(),f=N[(i+=[1,2,-1,3,-2][Math.floor(Math.random()*5)]+N.length)%N.length];
  o.type="triangle";o.frequency.value=f;g.gain.setValueAtTime(.0001,ac.currentTime);g.gain.exponentialRampToValueAtTime(.12,ac.currentTime+.03);g.gain.exponentialRampToValueAtTime(.0001,ac.currentTime+1.4);
  o.connect(g).connect(ac.destination);o.start();o.stop(ac.currentTime+1.5)},620)};

const fc=$("#fw"),fx=fc.getContext("2d");let P=[];
function fit(){fc.width=fc.clientWidth;fc.height=fc.clientHeight}
addEventListener("resize",fit);fit();
function burst(x,y){const h=Math.random()*360|0,n=48;for(let i=0;i<n;i++){const a=i/n*6.283,v=1.4+Math.random()*2.6;P.push({x,y,vx:Math.cos(a)*v,vy:Math.sin(a)*v,l:1,h:h+Math.random()*40})}}
function fireworks(n){for(let i=0;i<n;i++)setTimeout(()=>burst(fc.width*(.12+.76*Math.random()),fc.height*(.08+.32*Math.random())),i*380)}
function loop(){if(P.length||fx.__d){fx.globalCompositeOperation="destination-out";fx.fillStyle="rgba(0,0,0,.2)";fx.fillRect(0,0,fc.width,fc.height);fx.globalCompositeOperation="lighter";P=P.filter(p=>p.l>0);for(const p of P){p.x+=p.vx;p.y+=p.vy;p.vy+=.035;p.vx*=.985;p.l-=.011;fx.fillStyle=`hsla(${p.h},100%,65%,${Math.max(p.l,0)})`;fx.fillRect(p.x,p.y,2.4,2.4)}fx.__d=P.length>0;if(!P.length)fx.clearRect(0,0,fc.width,fc.height)}requestAnimationFrame(loop)}
fx.__d=true;loop();
$("#fwb").onclick=()=>fireworks(6);
if(!matchMedia("(prefers-reduced-motion:reduce)").matches){setTimeout(()=>fireworks(3),1500);setInterval(()=>fireworks(2),30000)}
const LC={gold:{n:"ส้มทอง",c:"#ffb43a",e:"#ff8a1f"},red:{n:"แดงชาด",c:"#e2505c",e:"#a8323e"},pink:{n:"ชมพูบัว",c:"#f4a6b8",e:"#c8607a"},white:{n:"ขาวนวล",c:"#fff3d6",e:"#d9b25f"}};
function lSVG(k){const c=LC[k]||LC.gold;return `<svg viewBox="0 0 60 90" aria-hidden="true"><path d="M14 18Q30 6 46 18L53 72Q30 84 7 72Z" fill="${c.c}" stroke="${c.e}" stroke-width="1.5"/><path d="M30 10V80M21 14Q18 48 15 76M39 14Q42 48 45 76" stroke="${c.e}" stroke-width=".8" fill="none" opacity=".7"/><rect x="14" y="14" width="32" height="5" rx="2" fill="#7a4a14"/><rect x="10" y="72" width="40" height="5" rx="2" fill="#7a4a14"/><ellipse cx="30" cy="60" rx="8" ry="11" fill="#fff6c8" opacity=".85"><animate attributeName="opacity" values=".95;.6;.95" dur="1.3s" repeatCount="indefinite"/></ellipse></svg>`}
function renderLanterns(){const L=$("#lan");L.replaceChildren();
 items.filter(k=>k.kind==="lantern").slice(0,16).forEach(k=>{const h=hash(k.id),d=22+h%14,b=document.createElement("button");b.className="kh";
  b.style.cssText=`left:${4+h%88}%;--d:${d}s;animation-delay:-${((Date.now()/1000+h)%d).toFixed(1)}s,-${h%4}s`;
  b.innerHTML=lSVG(k.lc)+"<span></span>";b.querySelector("span").textContent=k.name;b.setAttribute("aria-label","โคมลอยของ "+k.name);b.onclick=()=>show(k);L.appendChild(b)})}
const KINDS={krathong:"🪷 กระทง",lantern:"🏮 โคมลอย"};
function upd(){const l=sel.kind==="lantern";$("#krw").hidden=l;$("#lcw").hidden=!l;$("#go").textContent=l?"ปล่อยโคมลอย":"ลอยกระทง";pv()}
function kinds(){const b=$("#kinds");b.replaceChildren();Object.keys(KINDS).forEach(k=>{const e=document.createElement("button");e.type="button";e.className="opt";e.textContent=KINDS[k];e.setAttribute("aria-pressed",sel.kind===k);e.onclick=()=>{sel.kind=k;kinds();upd()};b.appendChild(e)})}
function lcs(){const b=$("#lcs");b.replaceChildren();Object.keys(LC).forEach(k=>{const e=document.createElement("button");e.type="button";e.className="opt";e.textContent=LC[k].n;e.setAttribute("aria-pressed",sel.lc===k);e.onclick=()=>{sel.lc=k;lcs();pv()};b.appendChild(e)})}
kinds();lcs();upd();
const WP=["ขอให้เรียนจบตามเป้าหมาย","ขอให้สุขภาพแข็งแรง","ขอให้ครอบครัวมีความสุข","ขอให้โชคดีมีงานดีๆ ทำ","ขอบคุณและขอขมาแม่น้ำ","ขอให้ทุกข์โศกลอยไปกับสายน้ำ"];
WP.forEach(w=>{const b=document.createElement("button");b.type="button";b.className="opt";b.textContent=w;b.onclick=()=>{$("#ws").value=w};$("#wp").appendChild(b)});
const TR=[{n:"ระนาดเอก",t:"triangle",N:[262,294,330,392,440,523,587,659],ms:430,d:.9,g:.12},{n:"ระฆังแก้ว",t:"sine",N:[523,587,659,784,880,1047],ms:950,d:2.6,g:.09},{n:"ซอสามสาย",t:"sawtooth",N:[196,220,262,294,330,392],ms:1100,d:1.5,g:.035,lp:900},{n:"ค่ำคืนสงบ",t:"sine",N:[131,165,196,220,262,330],ms:2600,d:5,g:.07,chord:1},{n:"หมอลำ (แคน)",t:"sawtooth",N:[330,392,440,494,587,659,784],ms:300,d:.5,g:.03,lp:1500}];
let ti=0,ni=0;
TR.forEach((x,i)=>{const o=document.createElement("option");o.value=i;o.textContent="♪ "+x.n;$("#trk").appendChild(o)});
function note(f,T){const o=ac.createOscillator(),g=ac.createGain();o.type=T.t;o.frequency.value=f;let out=g;if(T.lp){const l=ac.createBiquadFilter();l.type="lowpass";l.frequency.value=T.lp;g.connect(l);out=l}
 const n=ac.currentTime;g.gain.setValueAtTime(.0001,n);g.gain.exponentialRampToValueAtTime(T.g,n+.04);g.gain.exponentialRampToValueAtTime(.0001,n+T.d);o.connect(g);out.connect(ac.destination);o.start();o.stop(n+T.d+.1)}
function tick(){const T=TR[ti],N=T.N;ni=(ni+[1,2,-1,3,-2][Math.random()*5|0]+N.length)%N.length;if(T.chord){note(N[ni],T);note(N[(ni+2)%N.length],T);note(N[(ni+4)%N.length],T)}else note(N[ni],T)}
function playM(){clearInterval(tm);if($("#mus").getAttribute("aria-pressed")!=="true")return;ac=ac||new (window.AudioContext||window.webkitAudioContext)();ac.resume();tick();tm=setInterval(tick,TR[ti].ms)}
$("#mus").onclick=function(){this.setAttribute("aria-pressed",this.getAttribute("aria-pressed")!=="true");playM()};
$("#trk").onchange=e=>{ti=+e.target.value;playM()};
const bg=$("#bg"),bx=bg.getContext("2d"),RM=matchMedia("(prefers-reduced-motion:reduce)").matches;
let SL,ST=[],CL=[],BW=0,BH=0,HZ=0,MX=0,MY=0,MR=0;
const rnd=(a,b)=>a+Math.random()*(b-a);
function hill(c,col,amp,fr,base,ph){c.fillStyle=col;c.beginPath();c.moveTo(0,HZ+2);for(let x=0;x<=BW+6;x+=6){c.lineTo(x,HZ-base-(Math.sin(x*.004*fr+ph)+1)*amp*.5-Math.sin(x*.013*fr+ph*2)*amp*.2)}c.lineTo(BW,HZ+2);c.closePath();c.fill()}
function palm(c,x,y,h,lean,col){c.strokeStyle=col;c.lineCap="round";c.lineWidth=Math.max(3,h*.045);const tx=x+lean,ty=y-h;c.beginPath();c.moveTo(x,y);c.quadraticCurveTo(x+lean*.1,y-h*.55,tx,ty);c.stroke();c.lineWidth=Math.max(1.5,h*.022);for(let i=0;i<10;i++){const a=-Math.PI/2+(i-4.5)*.4,L=h*(.4+.1*((i*7)%3)/2);c.beginPath();c.moveTo(tx,ty);c.quadraticCurveTo(tx+Math.cos(a)*L*.7,ty+Math.sin(a)*L*.7-L*.3,tx+Math.cos(a)*L,ty+Math.sin(a)*L+L*.4);c.stroke()}}
function cloudSprite(){const w=300,h=80,c=document.createElement("canvas");c.width=w;c.height=h;const x=c.getContext("2d");for(let i=0;i<14;i++){const cx=rnd(40,w-40),cy=rnd(25,h-20),r=rnd(18,40),g=x.createRadialGradient(cx,cy,0,cx,cy,r);g.addColorStop(0,"rgba(150,155,210,.3)");g.addColorStop(1,"rgba(150,155,210,0)");x.fillStyle=g;x.beginPath();x.arc(cx,cy,r,0,6.3);x.fill()}return c}
function buildBG(){
 const dpr=Math.min(devicePixelRatio||1,2);BW=bg.clientWidth;BH=bg.clientHeight;if(!BW||!BH)return;
 bg.width=BW*dpr;bg.height=BH*dpr;HZ=BH*.42;MX=BW<600?BW*.3:BW*.62;MY=HZ*.34;MR=Math.min(34,BW*.05);
 const cs=getComputedStyle($("#scene")),ra=cs.getPropertyValue("--ra").trim()||"#10204a",rb=cs.getPropertyValue("--rb").trim()||"#1d3a73";
 SL=document.createElement("canvas");SL.width=BW*dpr;SL.height=BH*dpr;const c=SL.getContext("2d");c.scale(dpr,dpr);
 let g=c.createLinearGradient(0,0,0,HZ);g.addColorStop(0,"#03061a");g.addColorStop(.5,"#0f1944");g.addColorStop(.82,"#2a2e66");g.addColorStop(1,"#7b4d68");c.fillStyle=g;c.fillRect(0,0,BW,HZ+2);
 g=c.createRadialGradient(BW*.5,HZ,0,BW*.5,HZ,BW*.55);g.addColorStop(0,"rgba(255,180,58,.35)");g.addColorStop(1,"rgba(255,180,58,0)");c.fillStyle=g;c.fillRect(0,0,BW,HZ+2);
 g=c.createRadialGradient(MX,MY,MR*.8,MX,MY,MR*5);g.addColorStop(0,"rgba(255,243,200,.35)");g.addColorStop(1,"rgba(255,243,200,0)");c.fillStyle=g;c.beginPath();c.arc(MX,MY,MR*5,0,6.3);c.fill();
 g=c.createRadialGradient(MX-MR*.3,MY-MR*.3,MR*.1,MX,MY,MR);g.addColorStop(0,"#fffbe8");g.addColorStop(1,"#f1dd9c");c.fillStyle=g;c.beginPath();c.arc(MX,MY,MR,0,6.3);c.fill();
 c.fillStyle="rgba(190,165,100,.35)";[[-.3,-.1,.28],[.25,.2,.2],[.1,-.45,.15],[-.2,.4,.17],[.4,-.2,.12]].forEach(([a,b,r])=>{c.beginPath();c.arc(MX+a*MR,MY+b*MR,r*MR,0,6.3);c.fill()});
 hill(c,"#18235a",30,.8,10,.9);hill(c,"#0d1640",18,1.7,3,2.2);
 g=c.createLinearGradient(0,HZ,0,BH);g.addColorStop(0,rb);g.addColorStop(1,ra);c.fillStyle=g;c.fillRect(0,HZ,BW,BH-HZ);
 g=c.createLinearGradient(0,HZ,0,BH);g.addColorStop(0,"rgba(5,8,22,.15)");g.addColorStop(1,"rgba(5,8,22,.6)");c.fillStyle=g;c.fillRect(0,HZ,BW,BH-HZ);
 g=c.createLinearGradient(0,HZ-40,0,HZ+30);g.addColorStop(0,"rgba(150,160,220,0)");g.addColorStop(.6,"rgba(150,160,220,.18)");g.addColorStop(1,"rgba(150,160,220,0)");c.fillStyle=g;c.fillRect(0,HZ-40,BW,70);
 c.fillStyle="#04060f";[[BW*.04,.1],[BW*.95,.14]].forEach(([x,w])=>{c.beginPath();c.ellipse(x,HZ+4,BW*w,9,0,0,6.3);c.fill()});
 palm(c,BW*.94,HZ+2,HZ*.72,-24,"#04060f");palm(c,BW*.975,HZ+2,HZ*.5,14,"#04060f");palm(c,BW*.025,HZ+2,HZ*.55,18,"#04060f");
 for(let i=0;i<9;i++){const x=i%2?BW-rnd(0,BW*.16):rnd(0,BW*.16),y=BH-rnd(4,50),rx=rnd(18,40);c.fillStyle="rgba(8,30,28,.85)";c.strokeStyle="rgba(120,180,140,.25)";c.beginPath();c.ellipse(x,y,rx,rx*.28,0,0,6.3);c.fill();c.stroke()}
 c.strokeStyle="#040712";c.lineWidth=2;for(let i=0;i<22;i++){const x=i%2?BW-rnd(0,BW*.1):rnd(0,BW*.1),h=rnd(50,120);c.beginPath();c.moveTo(x,BH);c.quadraticCurveTo(x+rnd(-10,10),BH-h*.6,x+rnd(-16,16),BH-h);c.stroke()}
 g=c.createRadialGradient(BW/2,BH/2,BH*.3,BW/2,BH/2,BW*.7);g.addColorStop(0,"rgba(0,0,0,0)");g.addColorStop(1,"rgba(0,0,0,.45)");c.fillStyle=g;c.fillRect(0,0,BW,BH);
 ST=Array.from({length:Math.round(BW/6)},()=>({x:rnd(0,BW),y:rnd(0,HZ*.85),r:rnd(.5,1.6),p:rnd(0,6.3),s:rnd(.8,2.6)}));
 CL=Array.from({length:5},()=>({s:cloudSprite(),x:rnd(0,BW+400),y:rnd(HZ*.05,HZ*.65),v:rnd(3,8),k:rnd(.9,1.7),a:rnd(.45,.95)}));
 drawBG(performance.now()/1000)}
function refl(x,w0,rgb,a0,t){const y0=HZ+3,L=BH-y0;for(let y=y0,i=0;y<BH;y+=4,i++){const q=(y-y0)/L,w=(w0+q*w0*1.2)*(.35+.65*Math.abs(Math.sin(i*1.7+t*1.4))),o=Math.sin(i*.9+t*.8)*(2+q*10);bx.fillStyle=`rgba(${rgb},${(a0*(1-q*.85)*(.4+.6*Math.abs(Math.sin(i*2.3+t)))).toFixed(3)})`;bx.fillRect(x+o-w/2,y,w,1.8)}}
function drawBG(t){if(!SL)return;const d=bg.width/BW;bx.setTransform(1,0,0,1,0,0);bx.drawImage(SL,0,0);bx.setTransform(d,0,0,d,0,0);
 for(const s of ST){if(Math.hypot(s.x-MX,s.y-MY)<MR*4)continue;bx.globalAlpha=.35+.65*Math.abs(Math.sin(t*s.s+s.p));bx.fillStyle="#fff";bx.fillRect(s.x,s.y,s.r,s.r)}
 for(const c of CL){const x=((c.x+t*c.v)%(BW+500))-350;bx.globalAlpha=c.a;bx.drawImage(c.s,x,c.y,300*c.k,80*c.k)}
 bx.globalAlpha=1;refl(MX,MR*2.2,"255,244,200",.55,t);
 [[.116,.5],[.308,.8],[.5,1],[.692,.8],[.884,.5]].forEach(([f,k])=>refl(BW*f,14,"255,170,60",.4*k,t));bx.globalAlpha=1}
buildBG();window.bgReady=true;
let rz;addEventListener("resize",()=>{clearTimeout(rz);rz=setTimeout(buildBG,200)});
if(!RM){let last=0;const lp=ts=>{if(ts-last>33){last=ts;drawBG(ts/1000)}requestAnimationFrame(lp)};requestAnimationFrame(lp)}
const PERM=[6,2,10,4,8,0,12,1,7,3,9,5,11,13],NS=14,BK=Object.keys(BASES);
function renderCrowd(){const C=$("#crowd");C.replaceChildren();
 for(let s=0;s<NS;s++){const rank=PERM.indexOf(s),k=rank<10?items[rank]:null,row=s%3,real=!!k,el=document.createElement(real?"button":"div");
  el.className="pp"+(real?" real":"");el.style.cssText=`left:${4+s*7.2}%;bottom:${row*16}px;--sc:${(1-row*.1).toFixed(2)};--dl:-${(s*.7%4).toFixed(1)}s;z-index:${3-row}`;
  const ch=real?(PEOPLE[k.ch]?k.ch:"c"+(1+hash(k.id)%6)):"c"+(1+(s*5+2)%6);
  const hk=real?(k.kind==="lantern"?lSVG(k.lc):kSVG(k)):kSVG({base:BK[s%BK.length],top:{flower:1,candle:1,incense:s%2}});
  el.innerHTML=`<div class='pi'>${pSVG(ch)}<div class='hk'>${hk}</div></div>`;
  if(real){const n=document.createElement("span");n.className="pn";n.textContent=k.name;el.prepend(n);el.setAttribute("aria-label","ผู้ลอย "+k.name);el.onclick=()=>show(k)}
  C.appendChild(el)}}
function ghost(){const R=$("#river"),b=document.createElement("div"),lane=Math.random()*4|0;b.className="kg";
 b.innerHTML=kSVG({base:BK[Math.random()*BK.length|0],top:{flower:Math.random()<.7,garland:Math.random()<.3,ribbon:Math.random()<.3,incense:Math.random()<.6,candle:Math.random()<.85}});
 b.style.cssText=`top:${lane*17+Math.random()*8}%;zoom:${(.55+lane*.09).toFixed(2)};--v:${rnd(90,160)|0}s;--l:${rnd(0,95)|0}%;animation-delay:-${rnd(0,150)|0}s,-${rnd(0,3).toFixed(1)}s`;R.appendChild(b)}
function launch(){const R=$("#river"),b=document.createElement("div");b.className="kg ln";b.innerHTML=kSVG({base:BK[Math.random()*BK.length|0],top:{flower:1,candle:1,incense:1}});
 b.style.cssText=`left:${4+(Math.random()*NS|0)*7.2}%;top:calc(100% - 120px);zoom:.8`;b.onanimationend=e=>{if(e.animationName==="launch")b.remove()};R.appendChild(b)}
for(let i=0;i<22;i++)ghost();
if(!RM){setInterval(launch,5000);setTimeout(launch,1200)}
(async()=>{renderAll();
 let db=null;try{db=window.claude?await window.claude.use("db"):null}catch(e){}
 if(!db){$("#status").textContent="โหมดทดลอง: กระทงจะแสดงเฉพาะในหน้านี้ (ต้องเข้าสู่ระบบจึงจะเห็นแบบเรียลไทม์)";return}
 col=db.collection("floats");let got=false;
 const timer=setTimeout(()=>{if(!got)$("#status").textContent="กำลังเชื่อมต่อ..."},10000);
 col.orderBy("t","desc").limit(200).onSnapshot(s=>{got=true;clearTimeout(timer);items=s.docs.map(d=>({id:d.id,...d.data()}));$("#status").textContent="อัปเดตแบบเรียลไทม์";renderAll()},
  ()=>{$("#status").textContent="เชื่อมต่อไม่ได้ ลองรีเฟรชหน้า"});
